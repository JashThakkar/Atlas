# Atlas Fitness - Environment Variables
# Copy this file to .env and fill in your actual values

# Gemini API Key for AI Diet Coach
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Exercise API Configuration (Optional - app works with sample data if not provided)
# Get your key from: https://api-ninjas.com/ or other exercise API provider
EXERCISE_API_KEY=your_exercise_api_key_here
EXERCISE_API_BASE_URL=https://api.api-ninjas.com/v1

# Spotify Integration (Optional - enables the in-app music player)
# Setup steps:
#   1. Go to https://developer.spotify.com/dashboard and create an app.
#   2. Copy the Client ID below.
#   3. In the app settings add the redirect URI: atlasfit://spotify-callback
# Note: Playback control (play/pause/skip) requires a Spotify Premium account.
#       All Spotify accounts can view the currently-playing track.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
